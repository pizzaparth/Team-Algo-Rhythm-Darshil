# --- LLM & Search providers (read server-side only, see server/routes/ai.ts) ---
# The frontend never sees these — it calls same-origin /api/v1/ai/* routes,
# which the Express server proxies to the real providers using these keys.
VITE_MIMO_API_KEY="MY_MIMO_API_KEY"
VITE_MIMO_MODEL="mimo-v2.5-pro"
VITE_TAVILY_API_KEY="MY_TAVILY_API_KEY"

# --- Server ---
NODE_ENV="development"
API_PORT="3002"
JWT_SECRET="MY_JWT_SECRET"
JWT_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="7d"
DATABASE_PATH="./data/workspace.db"
LOG_LEVEL="info"
ALLOWED_ORIGIN="http://localhost:3001"
